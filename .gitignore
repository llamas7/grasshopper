# Ignore everything by default. This repository should track only the
# grasshopper Python library and files needed to develop/test it.
*

# Keep repository metadata/configuration.
!.gitignore
!.gitattributes
!README.md
!pyproject.toml
!requirements.txt

# Keep the library package.
!grasshopper/
!grasshopper/**

# Keep tests for the library.
!tests/
!tests/**

# Keep library examples, but not generated example output.
!examples/
!examples/parallel_tempering_square_lattice_demo.py

# Ignore generated/cache files even inside unignored directories.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Ignore packaging/build artifacts.
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Ignore local environments and editor/OS files.
.env
.venv/
env/
venv/
ENV/
.codex-python/
.pip-tmp/
.DS_Store
.idea/
.vscode/

# Keep non-library work out of version control.
David_Llamas___Dissertation/
David_Llamas__Dissertation/
Grasshopper Papers/
Gauss_data/
tmp/
_minted-*/
*.ipynb
*.tex
